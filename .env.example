# ─── LLM Configuration ───────────────────────────────────────────────────────
# Option A: OpenAI (default)
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4o

# Option B: Groq (free, fast - recommended for demos)
# OPENAI_API_KEY=gsk_your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Option C: Local Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# OPENAI_API_KEY=ollama

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000

# ─── Data Configuration ───────────────────────────────────────────────────────
DUCKDB_PATH=:memory:
MAX_RESULT_ROWS=500
MAX_FILE_SIZE_MB=50

# ─── API Configuration ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Add your frontend URL to allow CORS (Railway URL when deployed)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ─── Query Safety ─────────────────────────────────────────────────────────────
MAX_QUERY_TIMEOUT_SECONDS=30
REPAIR_MAX_ATTEMPTS=1
SQL_ROW_LIMIT=500

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
