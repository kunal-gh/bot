# ─── LLM Configuration ─────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2000
LLM_REPAIR_MODEL=gpt-3.5-turbo

# ─── Data Configuration ────────────────────────────
DATA_DIR=./data
WORKBOOK_PATH=./data/workbook.xlsx
DUCKDB_PATH=:memory:
MAX_RESULT_ROWS=500
MAX_FILE_SIZE_MB=50

# ─── API Configuration ─────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8501

# ─── Logging ───────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# ─── Query Safety ──────────────────────────────────
MAX_QUERY_TIMEOUT_SECONDS=30
REPAIR_MAX_ATTEMPTS=1
SQL_ROW_LIMIT=500
